# ============================================================================
# Environment configuration — copy this file to `.env` and adjust the values.
#
#   cp .env.example .env        (Git Bash / macOS / Linux)
#   copy .env.example .env      (Windows cmd)
#
# WHY: connection strings and secrets must NEVER be hardcoded in source code.
# Anyone with read access to the repo (or the git history) would see them.
# The `.env` file is git-ignored; only this example template is committed.
# ============================================================================

NODE_ENV=development
PORT=4000
APP_NAME=mongo-bootcamp
SERVER_HOST=localhost

# ----------------------------------------------------------------------------
# MongoDB connection
#
# Local MongoDB (default install):    mongodb://127.0.0.1:27017
# Local replica set (transactions):   mongodb://127.0.0.1:27017/?replicaSet=rs0
# MongoDB Atlas (cloud):              mongodb+srv://<user>:<pass>@cluster.mongodb.net
#
# MONGO_DB_NAME is the database the bootcamp uses. MongoDB creates it
# automatically the first time a document is written into it.
# ----------------------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=mongo_bootcamp

# Maximum number of sockets the driver keeps open to MongoDB (connection pool).
# See lesson 02-connections for what this really means.
MONGO_POOL_SIZE=10

# JWT settings (used by the Express app template, not by the bootcamp lessons)
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRY=1d

LOG_LEVEL=info
CORS_ORIGIN=*
