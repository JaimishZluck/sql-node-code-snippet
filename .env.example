PORT=4000
# Port on which the HTTP server will run.

NODE_ENV=development
# Application environment: development, test, or production.

APP_NAME=BaseBackendService
# Human-friendly name for this backend service.

SERVER_HOST=localhost
# Hostname or IP address the server should bind to.

CORS_ORIGIN=*
# Comma-separated list of allowed origins for CORS. Use * only for development.
# TODO(project-setup): restrict CORS_ORIGIN for production deployments.

DB_NAME=base_project
# TODO(project-setup): update database name for your project.

DB_USERNAME=db_user
# TODO(project-setup): update database username for your project.

DB_PASSWORD=db_password
# TODO(project-setup): update database password for your project.

DB_HOST=localhost
# TODO(project-setup): update database host (e.g., localhost, db, or cloud host).

JWT_SECRET=dummy_secret_key
# Secret key used to sign JWT tokens.
# TODO(project-setup): change to a strong, unique secret in production.

JWT_EXPIRY=1d
# Default JWT token expiration (e.g., 15m, 1h, 1d).

LOG_LEVEL=info
# Minimum log level: error, warn, info, http, debug.

REDIS_URL=redis://localhost:6379
# TODO(project-setup): update Redis connection string if using Redis.

SOCKET_IO_PATH=/socket.io
# Base path for Socket.IO connections.

API_BASE_PREFIX=/api/v1
# TODO(project-setup): update API base path according to the new project requirements.

