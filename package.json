{
  "name": "superman-framework",
  "version": "1.0.0",
  "description": "Reusable backend architecture starter template with JWT auth, standardized utilities, and documentation.",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "superman-framework": "./bin/create.js"
  },
  "files": [
    "config",
    "migrations",
    "public",
    "scripts",
    "src",
    "package.json",
    ".gitignore",
    "bin"
  ],
  "scripts": {
    "dev": "nodemon --inspect=9229 -r dotenv/config src/index.js",
    "dev:simple": "nodemon -r dotenv/config src/index.js",
    "start": "node -r dotenv/config src/index.js",
    "start:inspect": "node --inspect=9229 -r dotenv/config src/index.js",
    "create": "node ./bin/create.js",
    "db:seed": "node -r dotenv/config src/seeders/seed.js",
    "db:reset": "node -r dotenv/config src/seeders/reset.js",
    "db:reseed": "npm run db:reset && npm run db:seed",
    "lesson": "node -r dotenv/config src/bootcamp/run-lesson.js",
    "bootcamp:api": "node -r dotenv/config src/bootcamp/api/server.js",
    "db:seed-admin": "node -r dotenv/config migrations/20260504120000-create-users-admin.js up",
    "db:seed-admin:undo": "node -r dotenv/config migrations/20260504120000-create-users-admin.js down",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.9",
    "boxen": "^8.0.1",
    "cls-hooked": "^4.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.15.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "os-utils": "^0.0.14",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "winston": "^3.14.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "nodemon": "^3.1.4"
  }
}