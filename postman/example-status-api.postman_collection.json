{
    "info": {
        "name": "Micro Services Arch - Example Status API",
        "description": "Collection for testing the authenticated example status endpoint.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Get Example Status",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/v1/status?includeUser=true",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "status"
                    ],
                    "query": [
                        {
                            "key": "includeUser",
                            "value": "true"
                        }
                    ]
                },
                "description": "Returns basic API status and decoded JWT user context when includeUser=true."
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Status code is 200', function () {",
                            "  pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test('Response indicates success', function () {",
                            "  var jsonData = pm.response.json();",
                            "  pm.expect(jsonData.success).to.eql(true);",
                            "  pm.expect(jsonData.data.service).to.eql('example');",
                            "});"
                        ]
                    }
                }
            ],
            "response": []
        }
    ],
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:4000"
        },
        {
            "key": "token",
            "value": ""
        }
    ]
}